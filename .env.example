# Learn Swahili - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Daily.co Video Configuration
# ===========================================
NEXT_PUBLIC_DAILY_API_KEY=your-daily-api-key
DAILY_API_SECRET=your-daily-api-secret

# ===========================================
# Stripe Payment Configuration (Inbound)
# ===========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ===========================================
# Paystack Configuration (Outbound - M-Pesa)
# ===========================================
PAYSTACK_SECRET_KEY=sk_test_your-paystack-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-key

# ===========================================
# Flutterwave Configuration (Alternative)
# ===========================================
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key

# ===========================================
# Application Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Learn Swahili"

# ===========================================
# Platform Settings
# ===========================================
# Commission rate in percentage (e.g., 15 = 15%)
PLATFORM_COMMISSION_RATE=15

# Minimum payout amounts in local currency cents
MIN_PAYOUT_KES=50000
MIN_PAYOUT_TZS=100000
MIN_PAYOUT_UGX=200000
